              "raw": "{{baseUrl}}/menus/{{menuId}}",
              "host": ["{{baseUrl}}"],
              "path": ["menus", "{{menuId}}"]
            },
            "description": "Retrieve complete hierarchical menu tree including categories and dish items."
          },
          "response": []
        },
        {
          "name": "List Menus for Restaurant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (Array.isArray(jsonData) && jsonData.length > 0) {",
                  "    for (var i = 0; i < jsonData.length; i++) {",
                  "        if (jsonData[i].categories && jsonData[i].categories.length > 0) {",
                  "            pm.collectionVariables.set(\"categoryId\", jsonData[i].categories[0].id);",
                  "            console.log(\"Saved categoryId from restaurant menus:\", jsonData[i].categories[0].id);",
                  "            if (jsonData[i].categories[0].items && jsonData[i].categories[0].items.length > 0) {",
                  "                pm.collectionVariables.set(\"menuItemId\", jsonData[i].categories[0].items[0].id);",
                  "                console.log(\"Saved menuItemId from restaurant menus:\", jsonData[i].categories[0].items[0].id);",
                  "            }",
                  "            break;",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
