                  "        pm.collectionVariables.set(\"menuItemId\", jsonData.categories[0].items[0].id);",
                  "        console.log(\"Saved menuItemId:\", jsonData.categories[0].items[0].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
