{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
    "name": "Restaurant Platform API",
    "description": "Production-grade Postman collection for testing the Restaurant Discovery, Menus, QR Ordering, Table Reservations, and Admin REST API.\n\n### Usage Guide:\n1. Import this JSON directly into Postman (**File -> Import**).\n2. The collection uses `{{baseUrl}}` (default: `http://localhost:8000/api/v1`).\n3. Execute **Authentication -> Login** to automatically save `accessToken` and `refreshToken` into collection variables.\n4. All subsequent secured endpoints automatically inherit the Bearer token.\n5. Chaining scripts dynamically populate `userId`, `restaurantId`, `restaurantSlug`, `menuId`, `categoryId`, and `menuItemId` as you run requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health & System",
      "description": "Liveness probes, database connectivity checks, and latency metrics.",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Liveness check verifying FastAPI application is running."
          },
          "response": []
        },
        {
          "name": "Database Connectivity & Latency",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health/database",
              "host": ["{{baseUrl}}"],
              "path": ["health", "database"]
            },
            "description": "Tests asynchronous PostgreSQL / Neon connection pool and reports query latency in milliseconds."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Authentication",
      "description": "User registration and JWT token issuance.",
      "item": [
        {
          "name": "Register New Customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var timestamp = Date.now();",
                  "var email = 'customer_' + timestamp + '@example.com';",
                  "pm.collectionVariables.set('customerEmail', email);",
                  "pm.collectionVariables.set('customerPassword', 'SecurePass123!');",
                  "console.log('Generated customer email:', email);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"userId\", jsonData.id);",
                  "    console.log(\"Saved userId:\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"full_name\": \"Alex Mercer\",\n  \"phone\": \"+1-555-019-2834\",\n  \"role\": \"customer\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new customer account. Password is automatically hashed using Argon2id."
          },
          "response": []
        },
        {
          "name": "Register Restaurant Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"ownerId\", jsonData.id);",
                  "    console.log(\"Saved ownerId:\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner_{{$timestamp}}@restaurant.com\",\n  \"full_name\": \"Marco Rossi\",\n  \"phone\": \"+1-555-888-9900\",\n  \"role\": \"restaurant_owner\",\n  \"password\": \"ChefOwnerSecret2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Register an account with the `restaurant_owner` role."
          },
          "response": []
        },
        {
          "name": "Login (Obtain JWT Access & Refresh Tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.access_token);",
                  "    pm.collectionVariables.set(\"refreshToken\", jsonData.refresh_token);",
                  "    console.log(\"Saved accessToken and refreshToken into collection variables!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate user credentials. Automatically updates `accessToken` and `refreshToken` in Postman collection variables."
          },
          "response": []
        }
      ]
