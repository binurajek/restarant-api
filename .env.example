# ==============================================================================
# Application Configuration
# ==============================================================================
APP_NAME=restaurant-platform
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change_me_to_a_secure_random_string_at_least_32_chars_long
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# ==============================================================================
# Database Configuration (PostgreSQL / Neon)
# ==============================================================================
# Development: Docker PostgreSQL (default)
# Production:  Neon PostgreSQL (e.g. postgresql+asyncpg://<user>:<password>@<ep-xyz>.eu-central-1.aws.neon.tech/restaurant_db?ssl=require)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=restaurant_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/restaurant_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ==============================================================================
# Cache & Message Broker (Redis)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Authentication & Security
# ==============================================================================
JWT_SECRET=change_me_to_a_secure_jwt_secret_minimum_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth2 Providers (Optional in local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ==============================================================================
# External Integrations (Optional in initial foundation)
# ==============================================================================
# AI / OCR Services
OPENAI_API_KEY=

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloud Storage (Azure Blob / S3)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=restaurant-media

# Geolocation & Maps
GOOGLE_MAPS_API_KEY=

# Email / Notifications (SMTP / SendGrid / FCM)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@restaurantplatform.com
FCM_SERVER_KEY=
